<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0f766e">
  <meta name="description" content="تطبيق إسلامي يعمل بدون إنترنت">
  <link rel="manifest" href="manifest.json">
  <link rel="stylesheet" href="style.css">
  <title>نور الإسلام</title>
</head>

<body>

<header class="topbar">
  <div>
    <h1>نور الإسلام</h1>
    <p>رفيقك الإسلامي كل يوم</p>
  </div>

  <button id="themeBtn" class="icon-btn" aria-label="الوضع الليلي">🌙</button>
</header>

<main>

  <section id="home" class="page active">

    <div class="welcome-card">
      <div>
        <span>السلام عليكم ورحمة الله وبركاته</span>
        <h2>أهلاً بك في نور الإسلام</h2>
        <p>القرآن والأذكار والسبحة ومواقيت الصلاة في مكان واحد.</p>
      </div>
      <div class="mosque">🕌</div>
    </div>

    <div class="section-title">
      <h2>الأقسام</h2>
    </div>

    <div class="grid">

      <button class="feature-card" onclick="openPage('quran')">
        <span class="feature-icon">📖</span>
        <strong>القرآن الكريم</strong>
        <small>قراءة السور والآيات</small>
      </button>

      <button class="feature-card" onclick="openPage('azkar')">
        <span class="feature-icon">🤲</span>
        <strong>الأذكار</strong>
        <small>أذكار الصباح والمساء</small>
      </button>

      <button class="feature-card" onclick="openPage('tasbeeh')">
        <span class="feature-icon">📿</span>
        <strong>السبحة</strong>
        <small>عداد التسبيح الإلكتروني</small>
      </button>

      <button class="feature-card" onclick="openPage('prayer')">
        <span class="feature-icon">🕌</span>
        <strong>الصلاة</strong>
        <small>مواقيت الصلاة</small>
      </button>

      <button class="feature-card" onclick="openPage('qibla')">
        <span class="feature-icon">🧭</span>
        <strong>القبلة</strong>
        <small>اتجاه القبلة</small>
      </button>

      <button class="feature-card" onclick="openPage('duaa')">
        <span class="feature-icon">✨</span>
        <strong>الأدعية</strong>
        <small>مجموعة من الأدعية</small>
      </button>

    </div>

    <div class="daily-card">
      <span>🌿 ذكر اليوم</span>
      <p>سُبْحَانَ اللَّهِ وَبِحَمْدِهِ</p>
      <small>كررها قدر استطاعتك</small>
    </div>

  </section>


  <section id="quran" class="page">

    <button class="back-btn" onclick="openPage('home')">→ الرئيسية</button>

    <h2>📖 القرآن الكريم</h2>

    <div class="search-box">
      <input id="surahSearch" type="search" placeholder="ابحث عن سورة..." oninput="searchSurah()">
    </div>

    <div id="surahList" class="list"></div>

    <div id="quranReader" class="reader hidden">
      <button class="back-btn" onclick="closeReader()">→ السور</button>
      <h2 id="readerTitle"></h2>
      <div id="ayahs"></div>
    </div>

  </section>


  <section id="azkar" class="page">

    <button class="back-btn" onclick="openPage('home')">→ الرئيسية</button>

    <h2>🤲 الأذكار</h2>

    <div class="tabs">
      <button onclick="showAzkar('morning')">أذكار الصباح</button>
      <button onclick="showAzkar('evening')">أذكار المساء</button>
      <button onclick="showAzkar('general')">أذكار عامة</button>
    </div>

    <div id="azkarList"></div>

  </section>


  <section id="tasbeeh" class="page">

    <button class="back-btn" onclick="openPage('home')">→ الرئيسية</button>

    <h2>📿 السبحة الإلكترونية</h2>

    <div class="tasbeeh-card">

      <div id="counter" class="counter">0</div>

      <p id="dhikrText">سبحان الله</p>

      <button id="tasbeehBtn" class="tasbeeh-btn">اضغط للتسبيح</button>

      <div class="tasbeeh-actions">
        <button onclick="resetTasbeeh()">إعادة</button>
        <button onclick="changeDhikr()">تغيير الذكر</button>
      </div>

    </div>

  </section>


  <section id="prayer" class="page">

    <button class="back-btn" onclick="openPage('home')">→ الرئيسية</button>

    <h2>🕌 مواقيت الصلاة</h2>

    <div class="location-card">
      <strong>الموقع</strong>
      <p id="locationText">مواقيت محفوظة محليًا</p>
    </div>

    <div class="prayer-list">

      <div class="prayer-item">
        <span>الفجر</span>
        <strong id="fajr">05:00</strong>
      </div>

      <div class="prayer-item">
        <span>الشروق</span>
        <strong id="sunrise">06:20</strong>
      </div>

      <div class="prayer-item">
        <span>الظهر</span>
        <strong id="dhuhr">12:00</strong>
      </div>

      <div class="prayer-item">
        <span>العصر</span>
        <strong id="asr">15:30</strong>
      </div>

      <div class="prayer-item">
        <span>المغرب</span>
        <strong id="maghrib">18:00</strong>
      </div>

      <div class="prayer-item">
        <span>العشاء</span>
        <strong id="isha">19:20</strong>
      </div>

    </div>

    <p class="offline-note">
      تعمل هذه الصفحة بدون إنترنت. يمكن تحديث المواقيت عند توفر الإنترنت في النسخة القادمة.
    </p>

  </section>


  <section id="qibla" class="page">

    <button class="back-btn" onclick="openPage('home')">→ الرئيسية</button>

    <h2>🧭 اتجاه القبلة</h2>

    <div class="qibla-card">

      <div id="compass" class="compass">
        <div class="needle">▲</div>
        <span>🕋</span>
      </div>

      <p id="qiblaStatus">
        اضغط لبدء البوصلة
      </p>

      <button onclick="startCompass()" class="primary-btn">
        تشغيل البوصلة
      </button>

    </div>

  </section>


  <section id="duaa" class="page">

    <button class="back-btn" onclick="openPage('home')">→ الرئيسية</button>

    <h2>✨ الأدعية</h2>

    <div id="duaaList"></div>

  </section>


  <section id="settings" class="page">

    <button class="back-btn" onclick="openPage('home')">→ الرئيسية</button>

    <h2>⚙️ الإعدادات</h2>

    <div class="settings-card">

      <button onclick="toggleDarkMode()">
        🌙 الوضع الليلي
      </button>

      <button onclick="clearSavedData()">
        🗑️ مسح البيانات المحلية
      </button>

      <div class="offline-status">
        <span>حالة التطبيق:</span>
