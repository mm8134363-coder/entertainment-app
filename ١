* {
  box-sizing: border-box;
}

:root {
  --primary: #0f766e;
  --primary-dark: #115e59;
  --bg: #f5f7f6;
  --card: #ffffff;
  --text: #17201e;
  --muted: #6b7774;
  --border: #e3e9e7;
}

body.dark {
  --bg: #101716;
  --card: #18211f;
  --text: #f1f5f4;
  --muted: #aab7b3;
  --border: #293633;
}

body {
  margin: 0;
  font-family: Arial, Tahoma, sans-serif;
  background: var(--bg);
  color: var(--text);
  padding-bottom: 80px;
  transition: 0.25s;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.topbar {
  min-height: 75px;
  padding: 15px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-bottom: 1px solid var(--border);
}

.topbar h1 {
  margin: 0;
  font-size: 23px;
  color: var(--primary);
}

.topbar p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.icon-btn {
  border: 0;
  background: var(--bg);
  border-radius: 50%;
  width: 44px;
  height: 44px;
  font-size: 20px;
}

main {
  max-width: 850px;
  margin: auto;
  padding: 18px;
}

.page {
  display: none;
}

.page.active {
  display: block;
}

.welcome-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  padding: 22px;
  border-radius: 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.welcome-card h2 {
  margin: 10px 0;
}

.welcome-card p {
  margin: 0;
  opacity: 0.9;
  line-height: 1.7;
}

.mosque {
  font-size: 55px;
}

.section-title {
  margin: 15px 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.feature-card {
  background: var(--card);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 20px 12px;
  text-align: center;
  box-shadow: 0 3px 12px rgba(0,0,0,.04);
}

.feature-icon {
  display: block;
  font-size: 34px;
  margin-bottom: 10px;
}

.feature-card strong {
  display: block;
  margin-bottom: 6px;
}

.feature-card small {
  color: var(--muted);
}

.daily-card {
  margin-top: 18px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
}

.daily-card span {
  color: var(--primary);
  font-weight: bold;
}

.daily-card p {
  font-size: 20px;
  line-height: 2;
}

.daily-card small {
  color: var(--muted);
}

.back-btn {
  border: 0;
  background: transparent;
  color: var(--primary);
  padding: 8px 0;
  margin-bottom: 12px;
  font-weight: bold;
}

.search-box {
  margin: 15px 0;
}

.search-box input {
  width: 100%;
  padding: 14px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  border-radius: 14px;
  outline: none;
}

.list {
  display: grid;
  gap: 10px;
}

.surah-item {
  width: 100%;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text);
}

.surah-number {
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reader {
  margin-top: 15px;
}

.hidden {
  display: none !important;
}

.ayah {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 18px;
  margin: 10px 0;
  font-size: 21px;
  line-height: 2.1;
}

.tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  margin: 15px 0;
}

.tabs button {
  white-space: nowrap;
  border: 0;
  background: var(--card);
  color: var(--text);
  padding: 12px 15px;
  border-radius: 12px;
  border: 1px solid var(--border);
}

.zikr-card,
.duaa-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 20px;
  margin: 12px 0;
  line-height: 2;
}

.zikr-card h3 {
  color: var(--primary);
}

.zikr-count {
  color: var(--muted);
  font-size: 13px;
}

.tasbeeh-card,
.qibla-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 30px 20px;
  text-align: center;
  margin-top: 20px;
}

.counter {
  font-size: 70px;
  font-weight: bold;
  color: var(--primary);
}

#dhikrText {
  font-size: 25px;
  margin: 15px;
}

.tasbeeh-btn {
  width: 190px;
  height: 190px;
  border-radius: 50%;
  border: 0;
  background: var(--primary);
  color: white;
  font-size: 20px;
  box-shadow: 0 8px 25px rgba(0,0,0,.15);
}

.tasbeeh-actions {
  margin-top: 20px;
  display: flex;
  justify-content: center;
  gap: 10px;
}

.tasbeeh-actions button,
.primary-btn {
  border: 0;
  padding: 12px 18px;
  border-radius: 12px;
  background: var(--primary);
  color: white;
}

.prayer-list {
  display: grid;
  gap: 10px;
  margin-top: 15px;
}

.prayer-item {
  background: var(--card);
  border: 1px solid var(--border);
  padding: 18px;
  border-radius: 15px;
  display: flex;
  justify-content: space-between;
}

.prayer-item strong {
  color: var(--primary);
}

.location-card,
.offline-note {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 15px;
  margin-top: 15px;
}

.offline-note {
  color: var(--muted);
  line-height: 1.8;
}

.compass {
  width: 240px;
  height: 240px;
  margin: 15px auto 25px;
  border-radius: 50%;
  border: 8px solid var(--primary);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 55px;
  transition: transform .2s;
}

.needle {
  position: absolute;
  top: 20px;
  font-size: 35px;
  color: #d33;
}

.settings-card {
  display: grid;
  gap: 10px;
  margin-top: 20px;
}

.settings-card button {
  text-align: right;
  background: var(--card);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 17px;
}

.offline-status {
  background: var(--card);
  border: 1px solid var(--border);
  padding: 17px;
  border-radius: 15px;
  display: flex;
  justify-content: space-between;
}

#onlineStatus {
  color: var(--primary);
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  right: 0;
  left: 0;
  height: 70px;
  background: var(--card);
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-around;
  z-index: 100;
}

.bottom-nav button {
  flex: 1;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 20px;
}

.bottom-nav span {
  display: block;
  font-size: 11px;
  margin-top: 4px;
}

@media (min-width: 700px) {
  .grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
