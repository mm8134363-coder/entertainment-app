/* التنقل */

function openPage(pageName) {

  document.querySelectorAll(".page").forEach(page => {
    page.classList.remove("active");
  });

  const page = document.getElementById(pageName);

  if (page) {
    page.classList.add("active");
    window.scrollTo(0, 0);
  }

  if (pageName === "quran") {
    renderSurahs();
  }

  if (pageName === "azkar") {
    showAzkar("morning");
  }

  if (pageName === "duaa") {
    renderDuaa();
  }
}


/* القرآن */

function renderSurahs(filter = "") {

  const list = document.getElementById("surahList");

  if (!list) return;

  list.innerHTML = "";

  surahs.forEach((name, index) => {

    if (
      filter &&
      !name.includes(filter)
    ) {
      return;
    }

    const button = document.createElement("button");

    button.className = "surah-item";

    button.innerHTML = `
      <span class="surah-number">${index + 1}</span>
      <strong>${name}</strong>
      <span>فتح ←</span>
    `;

    button.onclick = () => openSurah(name);

    list.appendChild(button);
  });
}

function searchSurah() {

  const value =
    document.getElementById("surahSearch").value.trim();

  renderSurahs(value);
}

function openSurah(name) {

  document.getElementById("surahList")
    .classList.add("hidden");

  document.querySelector(".search-box")
    .classList.add("hidden");

  document.getElementById("quranReader")
    .classList.remove("hidden");

  document.getElementById("readerTitle")
    .textContent = "سورة " + name;

  const container =
    document.getElementById("ayahs");

  container.innerHTML = "";

  const verses = quranSample[name];

  if (!verses) {

    container.innerHTML = `
      <div class="ayah">
        هذه السورة موجودة في قائمة القرآن،
        وسيتم إضافة نصها الكامل محليًا في قاعدة بيانات القرآن
        في النسخة النهائية.
      </div>
    `;

    return;
  }

  verses.forEach((verse, index) => {

    const div = document.createElement("div");

    div.className = "ayah";

    div.textContent =
      verse + " ﴿" + (index + 1) + "﴾";

    container.appendChild(div);
  });
}

function closeReader() {

  document.getElementById("quranReader")
    .classList.add("hidden");

  document.getElementById("surahList")
    .classList.remove("hidden");

  document.querySelector(".search-box")
    .classList.remove("hidden");
}


