    </div>

  </section>

</main>


<nav class="bottom-nav">

  <button onclick="openPage('home')">
    🏠
    <span>الرئيسية</span>
  </button>

  <button onclick="openPage('quran')">
    📖
    <span>القرآن</span>
  </button>

  <button onclick="openPage('azkar')">
    🤲
    <span>الأذكار</span>
  </button>

  <button onclick="openPage('tasbeeh')">
    📿
    <span>السبحة</span>
  </button>

  <button onclick="openPage('settings')">
    ⚙️
    <span>الإعدادات</span>
  </button>

</nav>


<script src="app.js"></script>

</body>
