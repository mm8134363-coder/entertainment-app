<!-- =========================================================
     صفحة القرآن الكريم
     ========================================================= -->

<section class="screen" id="quranScreen">

  <header class="top-header">
    <div class="header-row">

      <div class="header-text">
        <div class="app-name">القرآن الكريم</div>
        <div class="app-subtitle">كتاب الله نور القلوب</div>
      </div>

      <button class="header-button" onclick="openScreen('homeScreen')">
        ←
      </button>

    </div>
  </header>


  <!-- محتوى القرآن -->

  <div class="quran-page">

    <div class="quran-intro">

      <div class="quran-icon">
        📖
      </div>

      <h2>القرآن الكريم</h2>

      <p>
        القرآن الكريم كاملًا
      </p>

    </div>


    <!-- البحث -->

    <div class="quran-search">

      <input
        type="search"
        id="quranSearchInput"
        placeholder="ابحث عن سورة..."
        autocomplete="off"
      >

    </div>


    <!-- قائمة السور -->

    <div id="quranSurahList" class="quran-surah-list">

      <div class="quran-loading">
        جاري تحميل القرآن الكريم...
      </div>

    </div>

  </div>

</section>


<style>

/* =========================================================
   صفحة القرآن
   ========================================================= */

.quran-page {
  padding: 18px 15px 100px;
}


/* المقدمة */

.quran-intro {
  text-align: center;
  background: linear-gradient(
    135deg,
    #073b2a,
    #0b6349
  );

  color: white;
  border-radius: 24px;
  padding: 24px 15px;
  margin-bottom: 18px;
  box-shadow: 0 8px 25px rgba(0,0,0,.12);
}

.quran-icon {
  width: 62px;
  height: 62px;
  margin: 0 auto 10px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(255,255,255,.14);
  border-radius: 18px;

  font-size: 31px;
}

.quran-intro h2 {
  margin: 5px 0;
  font-size: 24px;
}

.quran-intro p {
  margin: 5px 0 0;
  opacity: .85;
  font-size: 14px;
}


/* البحث */

.quran-search {
  margin-bottom: 18px;
}

.quran-search input {
  width: 100%;
  box-sizing: border-box;

  border: 1px solid #dce7e2;
  background: #fff;

  border-radius: 16px;

  padding: 14px 16px;

  font-family: inherit;
  font-size: 15px;

  outline: none;
}

.quran-search input:focus {
  border-color: #08745a;
}


/* قائمة السور */

.quran-surah-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}


/* بطاقة السورة */

.quran-surah-card {
  width: 100%;

  border: 1px solid #e3ebe7;
  background: #fff;

  border-radius: 18px;

  padding: 13px;

  display: flex;
  align-items: center;

  gap: 13px;

  text-align: right;

  cursor: pointer;

  font-family: inherit;

  box-shadow: 0 3px 12px rgba(0,0,0,.045);

  transition: .2s;
}

.quran-surah-card:active {
  transform: scale(.98);
}


/* رقم السورة */

.quran-surah-number {
  width: 43px;
  height: 43px;

  flex: 0 0 43px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background: #eef6f2;
  color: #08745a;

  font-size: 14px;
  font-weight: 800;
}


/* معلومات السورة */

.quran-surah-info {
  flex: 1;
}

.quran-surah-name {
  font-size: 18px;
  font-weight: 800;
  color: #173d32;
}

.quran-surah-details {
  margin-top: 3px;

  font-size: 12px;
  color: #82918b;
}


/* السهم */

.quran-surah-arrow {
  color: #08745a;
  font-size: 25px;
}


/* التحميل */

.quran-loading {
  text-align: center;
  padding: 35px 10px;
  color: #71827b;
}


/* لا توجد نتائج */

.quran-empty {
  text-align: center;
  padding: 35px 10px;
  color: #71827b;
}


/* شاشة قراءة السورة */

.quran-reader {
  padding-bottom: 100px;
}


.quran-reader-header {
  display: flex;
  align-items: center;
  gap: 12px;

  background: #073b2a;
  color: white;

  border-radius: 20px;

  padding: 14px;

  margin-bottom: 15px;
}


.quran-back-button {
  width: 43px;
  height: 43px;

  border: 0;
  border-radius: 13px;

  background: rgba(255,255,255,.13);
  color: white;

  font-size: 24px;

  cursor: pointer;
}


.quran-reader-title {
  flex: 1;
  text-align: center;
  font-size: 21px;
  font-weight: 800;
}


.quran-reader-title small {
  display: block;
  margin-top: 4px;
  font-size: 11px;
  opacity: .75;
}


/* البسملة */

.quran-bismillah {
  text-align: center;

  padding: 22px 10px;

  color: #8a6a21;

  font-size: 22px;
  line-height: 2;

  font-weight: 700;
}


/* الآيات */

.quran-ayahs {
  background: #fff;

  border-radius: 22px;

  padding: 18px 15px;

  box-shadow: 0 4px 18px rgba(0,0,0,.05);
}


.quran-ayah {
  padding: 18px 4px;

  border-bottom: 1px solid #edf1ef;

  line-height: 2.25;

  font-family: "Amiri", "Noto Naskh Arabic", serif;

  font-size: 22px;

  color: #202b27;
}


.quran-ayah:last-child {
  border-bottom: 0;
}


.ayah-text {
  display: inline;
}


.ayah-number {
  display: inline-flex;

  width: 30px;
  height: 30px;

  margin-right: 7px;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #08745a;
  color: white;

  font-family: inherit;

  font-size: 12px;
  font-weight: 700;

  vertical-align: middle;
}


/* الوضع الليلي */

body.dark-mode .quran-surah-card,
body.dark-mode .quran-search input,
body.dark-mode .quran-ayahs {
  background: #10251f;
  border-color: #25443a;
}


body.dark-mode .quran-surah-name {
  color: #f0f5f2;
}


body.dark-mode .quran-surah-number {
  background: #193a30;
  color: #8ed3b7;
}


body.dark-mode .quran-surah-details,
body.dark-mode .quran-loading,
body.dark-mode .quran-empty {
  color: #9aaca5;
}


body.dark-mode .quran-ayah {
  color: #edf4f1;
  border-color: #25443a;
}


body.dark-mode .quran-search input {
  color: white;
}


/* الموبايل */

@media (max-width: 480px) {

  .quran-page {
    padding-left: 12px;
    padding-right: 12px;
  }

  .quran-ayah {
    font-size: 21px;
  }

}

</style>


<script>

/* =========================================================
   القرآن الكريم
   تحميل quran.json
   ========================================================= */

let noorQuran = [];


/* تحميل القرآن */

async function loadNoorQuran() {

  const list =
    document.getElementById("quranSurahList");

  if (!list) return;


  try {

    const response =
      await fetch("./quran.json", {
        cache: "no-cache"
      });


    if (!response.ok) {
      throw new Error("quran.json not found");
    }


    const data =
      await response.json();


    /*
      يدعم أكثر من شكل لملف quran.json
    */

    if (Array.isArray(data)) {

      noorQuran = data;

    }

    else if (Array.isArray(data.surahs)) {

      noorQuran = data.surahs;

    }

    else {

      throw new Error("Invalid Quran JSON");

    }


    renderNoorSurahs(noorQuran);


  } catch (error) {

    console.error(error);

    list.innerHTML = `
      <div class="quran-empty">
        تعذر تحميل القرآن الكريم
      </div>
    `;

  }

}


/* =========================================================
   عرض السور
   ========================================================= */

function renderNoorSurahs(surahs) {

  const list =
    document.getElementById("quranSurahList");

  if (!list) return;


  list.innerHTML = "";


  if (!surahs.length) {

    list.innerHTML = `
      <div class="quran-empty">
        لا توجد سور
      </div>
    `;

    return;
  }


  surahs.forEach((surah, index) => {

    const number =
      Number(
        surah.number ||
        surah.id ||
        index + 1
      );


    const name =
      surah.name_arabic ||
      surah.name ||
      surah.surah ||
      `السورة ${number}`;


    const ayahs =
      surah.ayahs ||
      surah.verses ||
      [];


    const card =
      document.createElement("button");


    card.className =
      "quran-surah-card";


    card.type = "button";


    card.innerHTML = `

      <div class="quran-surah-number">
        ${number}
      </div>

      <div class="quran-surah-info">

        <div class="quran-surah-name">
          ${name}
        </div>

        <div class="quran-surah-details">
          ${ayahs.length} آية
        </div>

      </div>

      <div class="quran-surah-arrow">
        ‹
      </div>

    `;


    card.onclick = function() {

      openNoorSurah(number);

    };


    list.appendChild(card);

  });

}


/* =========================================================
   فتح السورة
   ========================================================= */

function openNoorSurah(number) {

  const surah =
    noorQuran.find((item, index) => {

      return Number(
        item.number ||
        item.id ||
        index + 1
      ) === Number(number);

    });


  if (!surah) return;


  const name =
    surah.name_arabic ||
    surah.name ||
    surah.surah ||
    `السورة ${number}`;


  const ayahs =
    surah.ayahs ||
    surah.verses ||
    [];


  const list =
    document.getElementById("quranSurahList");


  if (!list) return;


  list.innerHTML = `

    <div class="quran-reader">

      <div class="quran-reader-header">

        <button
          class="quran-back-button"
          type="button"
          onclick="renderNoorSurahs(noorQuran)">
          → 
        </button>

        <div class="quran-reader-title">
          ${name}
          <small>سورة رقم ${number}</small>
        </div>

      </div>


      ${
        Number(number) !== 9
        ?
        `<div class="quran-bismillah">
          بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
        </div>`
        :
        ""
      }


      <div class="quran-ayahs">

        ${
          ayahs.map((ayah, index) => {

            const ayahNumber =
              ayah.numberInSurah ||
              ayah.number ||
              ayah.id ||
              index + 1;


            const text =
              ayah.text ||
              "";


            return `

              <div class="quran-ayah">

                <span class="ayah-text">
                  ${text}
                </span>

                <span class="ayah-number">
                  ${ayahNumber}
                </span>

              </div>

            `;

          }).join("")

        }

      </div>

    </div>

  `;


  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

}


/* =========================================================
   البحث عن السور
   ========================================================= */

document.addEventListener(
  "input",
  function(event) {

    if (
      event.target.id !==
      "quranSearchInput"
    ) return;


    const search =
      event.target.value
        .trim()
        .toLowerCase();


    const filtered =
      noorQuran.filter(
        (surah, index) => {

          const name =
            String(
              surah.name_arabic ||
              surah.name ||
              surah.surah ||
              ""
            ).toLowerCase();


          const number =
            String(
              surah.number ||
              surah.id ||
              index + 1
            );


          return (
            name.includes(search) ||
            number.includes(search)
          );

        }
      );


    renderNoorSurahs(filtered);

  }
);


/* =========================================================
   تشغيل القرآن
   ========================================================= */

if (
  document.readyState ===
  "loading"
) {

  document.addEventListener(
    "DOMContentLoaded",
    loadNoorQuran
  );

}
else {

  loadNoorQuran();

}

</script>
